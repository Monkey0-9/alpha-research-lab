# QuantAlpha Environment Configuration Example

# Backend Server URL (Frontend environment)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend FastAPI Settings
QUANT_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & Data Paths
DATA_DIR=data
MODEL_DIR=backend/models

# Real Market Data Providers (Yahoo Finance & Robinhood)
DATA_PROVIDER_PRIMARY=hybrid  # options: yfinance | robinhood | hybrid
REAL_DATA_AUTO_SYNC=false
MARKET_DATA_CACHE_TTL_SEC=300

# Robinhood Integration (Optional - for authenticated trading & private portfolio telemetry)
# Public quotes and market hours work without credentials.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_CODE=
ROBINHOOD_DEVICE_TOKEN=

# Third-Party Market APIs (Optional)
POLYGON_API_KEY=
FRED_API_KEY=

# Execution Mode
EXECUTION_MODE=PAPER
DEFAULT_UNIVERSE=sp500
TARGET_VOLATILITY=0.10
TRANSACTION_COST_BPS=5.0
